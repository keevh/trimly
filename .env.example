# Copy to .env on the production host and replace the placeholders with random values.
TRIMLY_IMAGE=ghcr.io/keevh/trimly:vX.Y.Z
POSTGRES_PASSWORD=replace-with-a-random-password
IP_HASH_SALT=replace-with-a-random-hex-secret
APP_BASE_URL=https://trimly.keevh.dev
PGSSL=false
CLEANUP_GRACE_DAYS=30
DEMO_EXPIRY_DAYS=7
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_HOURS=24
